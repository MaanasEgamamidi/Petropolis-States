  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center><size=40><b>OBJECTIVES</b></size><br>Welcome to Petropolis!
    Adopt a dog and care for it while managing your money in a stylized low-poly
    city. Watch your pet's five stats (Hunger, Happiness, Energy, Health, Cleanliness),
    earn a daily allowance, buy supplies, and chat with AI-powered shopkeepers
    to negotiate better prices. Explore, meet NPCs, earn badges, and survive multiple
    in-game days.<br><br><size=40><b>CONTROLS</b></size></align><br><align=left><indent=6%><b>Action<pos=40%>Controller<pos=72%>Keyboard
     /  Mouse</b><br>Move<pos=40%>Left Stick<pos=72%>W  /  A  /  S  /  D<br>Camera<pos=40%>Right
    Stick<pos=72%>Mouse<br>Jump<pos=40%>A  (South)<pos=72%>Space<br>Sprint<pos=40%>LT
     /  L3<pos=72%>Left Shift<br>Interact<pos=40%>X  (West)<pos=72%>E<br>Chat with
    NPC<pos=40%>Y  (North)<pos=72%>C<br>Feed pet<pos=40%>D-Pad Down<pos=72%>F<br>Inventory<pos=40%>D-Pad
    Left  /  Start<pos=72%>G<br>Pet statistics<pos=40%>D-Pad Right<pos=72%>Q<br>Teleport
    menu<pos=40%>D-Pad Up<pos=72%>T<br>Toggle minimap<pos=40%>LB<pos=72%>M<br>Pause
     /  Settings<pos=40%>RB  /  View<pos=72%>Esc<br>Back  /  Cancel<pos=40%>B  (East)<pos=72%>-</indent></align><br><br><align=center><b>Tip:</b>
    Keep cash in reserve, negotiate prices, and check stats often.<br>Hit <b>Let's
    Play!</b> when ready.</align>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 660cf1356726a154aa90b63dd2769fd7, type: 2}
